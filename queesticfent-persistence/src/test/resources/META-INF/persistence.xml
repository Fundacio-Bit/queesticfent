<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <persistence-unit name="queesticfentPULocal" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<class>org.fundaciobit.queesticfent.persistence.AccioJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.DepartamentJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.EntradaJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.FestiuJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.FitxerJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.IdiomaJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.ModificacioQueEsticFentJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.PersonalProjecteJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.ProjecteJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.TraduccioJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.TraduccioMapJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.UsuariJPA</class>
		<class>org.fundaciobit.queesticfent.persistence.UsuariDepartamentJPA</class>

        <!-- Desactivar cache -->
        <shared-cache-mode>NONE</shared-cache-mode>
        <!-- Desactivar validació -->
        <validation-mode>NONE</validation-mode>

        <properties>
         
        </properties>
    </persistence-unit>
</persistence>